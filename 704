
#include <iostream>
using namespace std;

int main() {
    int nums[] = {2, 5, 8, 12, 16, 23, 38, 56, 72, 91};
    int target = 23;

    int n = 10;

    int left = 0;
    int right = n - 1;

    while (left <= right) {

        int mid = left + (right - left) / 2;

        if (nums[mid] == target) {
            cout << "Target found at index: " << mid;
            return 0;
        }

        else if (nums[mid] < target) {
            left = mid + 1;
        }

        else {
            right = mid - 1;
        }
    }

    cout << "Target not found. Index: -1";

    return 0;
}
