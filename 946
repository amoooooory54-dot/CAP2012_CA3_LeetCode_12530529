
#include <iostream>
#include <vector>
using namespace std;

bool validateStackSequences(vector<int>& pushed, vector<int>& popped) {
    vector<int> st;
    int j = 0;

    for (int i = 0; i < pushed.size(); i++) {
        st.push_back(pushed[i]);

        while (!st.empty() && st.back() == popped[j]) {
            st.pop_back();
            j++;
        }
    }

    return st.empty();
}

int main() {
    int n;
    cin >> n;

    vector<int> pushed(n), popped(n);

    for (int i = 0; i < n; i++)
        cin >> pushed[i];

    for (int i = 0; i < n; i++)
        cin >> popped[i];

    if (validateStackSequences(pushed, popped))
        cout << "true";
    else
        cout << "false";

    return 0;
}
