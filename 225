
#include <iostream>
#include <queue>
using namespace std;

int main() {

    queue<int> q1, q2;

    int choice, x;

    do {
        cout << "\n1. Push";
        cout << "\n2. Pop";
        cout << "\n3. Top";
        cout << "\n4. Empty";
        cout << "\n5. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        if (choice == 1) {

            cout << "Enter number: ";
            cin >> x;

            q2.push(x);

            while (!q1.empty()) {
                q2.push(q1.front());
                q1.pop();
            }

            swap(q1, q2);

        }

        else if (choice == 2) {

            if (!q1.empty()) {
                cout << "Removed: " << q1.front() << endl;
                q1.pop();
            }
            else {
                cout << "Stack is empty" << endl;
            }

        }

        else if (choice == 3) {

            if (!q1.empty()) {
                cout << "Top: " << q1.front() << endl;
            }
            else {
                cout << "Stack is empty" << endl;
            }

        }

        else if (choice == 4) {

            if (q1.empty()) {
                cout << "Stack is empty" << endl;
            }
            else {
                cout << "Stack is not empty" << endl;
            }

        }

    } while (choice != 5);

    return 0;
}
