

#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

int main() {

    Node* head = new Node;
    Node* second = new Node;
    Node* third = new Node;

    head->data = 1;
    second->data = 2;
    third->data = 3;

    head->next = second;
    second->next = third;
    third->next = second;

    Node* slow = head;
    Node* fast = head;

    bool cycle = false;

    while (fast != NULL && fast->next != NULL) {

        slow = slow->next;
        fast = fast->next->next;

        if (slow == fast) {
            cycle = true;
            break;
        }
    }

    if (cycle == true) {
        cout << "true";
    }
    else {
        cout << "false";
    }

    return 0;
}
